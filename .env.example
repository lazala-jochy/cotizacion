# Copia a .env (no se sube a git). Solo para builds locales.
#
# GitHub Actions NO lee .env — usa el secret GH_TOKEN en el repo:
#   Settings → Secrets and variables → Actions → New repository secret
#   Nombre: GH_TOKEN   Valor: el mismo ghp_... que aquí abajo
#
# Permisos recomendados (fine-grained): Contents Read and Write en tu repo

GH_TOKEN=ghp_reemplaza_con_tu_token
