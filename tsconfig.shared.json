{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "shared/template-designer/dist",
    "rootDir": "shared/template-designer/src"
  },
  "include": ["shared/template-designer/src/**/*.ts"]
}
