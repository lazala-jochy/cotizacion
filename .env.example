# Copia a .env (no se sube a git). Solo para builds locales.
#
# GitHub Actions NO lee .env — usa el secret GH_TOKEN en el repo:
#   Settings → Secrets and variables → Actions → New repository secret
#   Nombre: GH_TOKEN   Valor: el mismo ghp_... que aquí abajo
#
# Permisos recomendados (fine-grained): Contents Read and Write en tu repo

GH_TOKEN=ghp_reemplaza_con_tu_token

# Solo si publicas la API en internet (VPS, dominio, túnel). Si usas la app de escritorio,
# déjalo sin definir: el correo envía el PDF adjunto y no un enlace a 127.0.0.1.
# BASE_URL=https://tudominio.com

# Licencias — servicio separado en license-server/ (obligatorio product key siempre)
# Al hacer npm run dist:publish (o dist / dist:mac / dist:win), prepare-dist.js copia
# estos valores a server/runtime-env.json dentro del instalador (.dmg / .exe).
# LICENSE_SERVER_URL=http://127.0.0.1:3948
# LICENSE_SERVER_URL=https://license-server-st94.onrender.com
# LICENSE_ENFORCE=true   # solo los módulos asignados en el servidor
